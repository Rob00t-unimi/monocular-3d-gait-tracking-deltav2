# Auto detect text files and perform LF normalization
* text=auto
data/dataset_manifest.json filter=lfs diff=lfs merge=lfs -text
data/cached_dataset_map.json filter=lfs diff=lfs merge=lfs -text
data/inference_results/raw/*.npz filter=lfs diff=lfs merge=lfs -text
data/inference_results/refined/*.npz filter=lfs diff=lfs merge=lfs -text
resources/*.pdf filter=lfs diff=lfs merge=lfs -text
